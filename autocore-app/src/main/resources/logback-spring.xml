<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Spring Boots färgkonverterare: %clr(...) färgar nivån i konsolen, stängs av när utdata inte är en terminal -->
    <conversionRule conversionWord="clr"
                    class="org.springframework.boot.logging.logback.ColorConverter"/>

    <!--
        Två mönster med samma innehåll:
        LOG_PATTERN används av filloggen och är ofärgat, så att inga ANSI-koder hamnar i filen.
        CONSOLE_PATTERN används av konsolen och är samma mönster med färg via %clr.
        MDC-nycklarna i %X{...} definieras i
        com.wac.autocore.logging.LogKeys (autocore-core).
        Namnen måste stämma exakt. Ändras en nyckel där måste den ändras i BÅDA mönstren här.
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} [corrId=%X{corrId:-} op=%X{op:-} user=%X{user:-} wo=%X{workOrderId:-}] - %msg%n"/>

    <property name="CONSOLE_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr(%logger{36}){cyan} [corrId=%X{corrId:-} op=%X{op:-} user=%X{user:-} wo=%X{workOrderId:-}] - %msg%n"/>

    <!-- Konsol: används av dev och test, inte headless -->
    <springProfile name="!headless">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <!-- Dev (standard): allt som inte är headless eller test -->
    <springProfile name="!headless &amp; !test">
        <logger name="com.wac" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Headless: roterande fillogg, ofärgad -->
    <springProfile name="headless">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/autocore-headless.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/autocore-headless.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>100MB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- Test: bara varningar och fel -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
